{
  "name": "pi-jev-wiki",
  "version": "0.8.1",
  "description": "Project mental-model wiki for pi, maintained by agent insights and Jev decisions",
  "type": "module",
  "license": "MIT",
  "author": "xAndreiLi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xAndreiLi/pi-jev-wiki.git"
  },
  "homepage": "https://github.com/xAndreiLi/pi-jev-wiki#readme",
  "bugs": {
    "url": "https://github.com/xAndreiLi/pi-jev-wiki/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "src",
    "skills",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "pi-package",
    "pi",
    "wiki",
    "jev",
    "knowledge-base"
  ],
  "pi": {
    "extensions": [
      "./src/extension.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "smoke": "jiti scripts/smoke.ts",
    "test:paging": "jiti scripts/paging-test.ts",
    "test:scale": "jiti scripts/scale-test.ts",
    "test:unit": "jiti scripts/unit-test.ts",
    "test:integration": "jiti scripts/integration-test.ts",
    "test:vector": "jiti scripts/vector-test.ts",
    "test:all": "tsc --noEmit && jiti scripts/unit-test.ts && jiti scripts/integration-test.ts && jiti scripts/scale-test.ts && jiti scripts/vector-test.ts",
    "release": "jiti scripts/release.ts",
    "toc:refresh": "jiti scripts/refresh-toc.ts",
    "prepublishOnly": "npm run test:all"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "optionalDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-pgvector": "^0.0.9",
    "@huggingface/transformers": "^4.3.0"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-pgvector": "^0.0.9",
    "@types/node": "^26.6.2",
    "jiti": "^2.7.0",
    "typebox": "^1.3.34",
    "typescript": "^5.5.4"
  }
}
